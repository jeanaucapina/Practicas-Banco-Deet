# PC del alumno en el banco virtual: el computador que las guias conectan al switch
# (192.168.1.100) y al convertidor USB-RS485 (/dev/ttyUSB0). Escritorio Linux en el
# navegador (noVNC, puerto 6080) con lo que piden las guias:
#   OpenPLC Editor (LD/FBD/ST)             escalera y bloques
#   Terminal (tambien web, ttyd en 7681)    ip, ping, arp, nc, nmap, tcpdump, tshark,
#                                          mbpoll, python3 + pymodbus + scapy,
#                                          mosquitto_pub/sub, picocom, socat
#   Wireshark                               captura en la interfaz del PC
#   QModMaster                              maestro Modbus de diagnostico (L6, L7)
#   Navegador (Falkon)                      http://192.168.1.10/ (L9), Node-RED...
# La red del banco la pone la pasarela cuando en el 3D se enchufa el cable del PC al
# switch (docker network connect tab_lan --ip 192.168.1.100). Nada que instalar.

# ── QModMaster desde el codigo (no esta en los repositorios de Ubuntu) ────────
FROM ubuntu:22.04 AS qmodmaster
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl unzip build-essential qtbase5-dev qt5-qmake qttools5-dev-tools \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN curl -fsSL -o q.zip https://github.com/zhanglongqi/qModMaster/archive/refs/heads/master.zip \
    && unzip -q q.zip && mv qModMaster-* qmodmaster
WORKDIR /src/qmodmaster
RUN qmake -qt=qt5 qModMaster.pro && make -j"$(nproc)" \
    && f=$(find . -maxdepth 2 -type f -iname "qmodmaster" -perm -u+x | head -1) \
    && strip "$f" && cp "$f" /usr/local/bin/qmodmaster

# ── El PC ─────────────────────────────────────────────────────────────────────
FROM advian/openplc_editor:ubuntu-jammy-2024-10-09
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb x11vnc novnc websockify openbox tint2 xterm fonts-dejavu-core x11-xserver-utils x11-utils \
        iproute2 iputils-ping net-tools netcat-openbsd nmap tcpdump tshark wireshark-qt \
        mbpoll mosquitto-clients socat picocom minicom curl less nano sudo ttyd iperf3 \
        falkon python3-pip libqt5widgets5 libqt5network5 \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir pymodbus==3.6.9 scapy==2.5.0 paho-mqtt==1.6.1
COPY --from=qmodmaster /usr/local/bin/qmodmaster /usr/local/bin/qmodmaster
COPY openplc/editor_arranque.sh /usr/local/bin/editor_arranque.sh
COPY openplc/pc_escritorio /etc/pc_escritorio
# Convertidor USB-RS485 (/dev/ttyUSB0) con la misma capa fisica que los equipos
COPY openplc/usb485.py dispositivos/bus485.py /opt/banco/
RUN sed -i 's/\r$//' /usr/local/bin/editor_arranque.sh /etc/pc_escritorio/* && chmod +x /usr/local/bin/editor_arranque.sh
ENTRYPOINT ["/usr/local/bin/editor_arranque.sh"]
