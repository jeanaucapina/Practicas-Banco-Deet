# Panel web del laboratorio (panel/panel.py): Python + el cliente de Docker
# para ver contenedores, compilar programas subidos y leer el monitor serie.
FROM docker:27-cli AS cli
FROM python:3.12-slim
COPY --from=cli /usr/local/bin/docker /usr/local/bin/docker
# `docker compose` para levantar la pila de una practica al prepararla (L13-L15)
COPY --from=cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
WORKDIR /tablero
CMD ["python", "-u", "panel/panel.py"]
