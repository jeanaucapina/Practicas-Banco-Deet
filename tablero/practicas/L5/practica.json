{
  "id": "L5",
  "titulo": "Planificación de red: topologías, VLAN, colas y redundancia",
  "equipo": "",
  "exige_programa": false,
  "lenguajes": [],
  "enunciado": "enunciado.md",
  "montaje": {
    "limpiar": false,
    "cables": [],
    "ordenes": [],
    "pila": true
  },
  "marcar": [],
  "verificacion": [
    {
      "txt": "Parte III · la red emulada (contenedor l5) está levantada",
      "hacer": [
        {
          "tipo": "docker",
          "args": [
            "inspect",
            "-f",
            "{{.State.Running}}",
            "l5"
          ],
          "regex": "true"
        }
      ]
    },
    {
      "txt": "Parte III · el control llega a su servidor (VLAN 10)…",
      "hacer": [
        {
          "tipo": "docker",
          "args": [
            "exec",
            "l5",
            "nodo",
            "controlador",
            "ping",
            "-c",
            "2",
            "-W",
            "1",
            "192.168.10.50"
          ],
          "regex": " 0% packet loss"
        }
      ]
    },
    {
      "txt": "…y la VLAN de vídeo está separada (sin ruta desde el control)",
      "hacer": [
        {
          "tipo": "docker",
          "args": [
            "exec",
            "l5",
            "nodo",
            "controlador",
            "sh",
            "-c",
            "ping -c 1 -W 1 192.168.20.50 2>&1 || true"
          ],
          "regex": "unreachable|100% packet loss"
        }
      ]
    },
    {
      "txt": "Parte IV · un filtro del troncal (802.1Q) manda el control EF a su clase",
      "hacer": [
        {
          "tipo": "docker",
          "args": [
            "exec",
            "l5",
            "nodo",
            "sw2",
            "tc",
            "filter",
            "show",
            "dev",
            "eth5"
          ],
          "regex": "protocol 802\\.1Q[\\s\\S]*(classid|flowid) 1:[0-9a-f]+[\\s\\S]*(ip_tos 184|00b80000)"
        }
      ]
    },
    {
      "txt": "Tabla L5.9 · las capturas de los escenarios en ~/trabajo/L5",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "ls ~/trabajo/L5/l5_*.pcapng 2>/dev/null | wc -l",
          "regex": "^\\s*([4-9]|\\d{2,})\\s*$"
        }
      ]
    }
  ]
}