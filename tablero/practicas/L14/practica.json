{
  "id": "L14",
  "titulo": "OPC UA con Python: datalogger y termostato del tablero",
  "equipo": "t1.esp32plc",
  "exige_programa": false,
  "lenguajes": [],
  "enunciado": "enunciado.md",
  "reiniciar": false,
  "montaje": {
    "limpiar": true,
    "cables": [],
    "energia": [
      [
        "t1.esp32plc",
        true
      ],
      [
        "t1.switch",
        true
      ]
    ],
    "cargar_plc": [
      [
        "t1.esp32plc",
        "_comun/plc_modbus_tcp.ino"
      ]
    ],
    "ordenes": [],
    "pila": true,
    "pc_actualizar": [
      "servidor_opcua.py",
      "docker-compose.yml"
    ]
  },
  "marcar": [
    "pc.eth",
    "t1.switch.p1",
    "t1.esp32plc.eth",
    "t1.switch.p2",
    "t1.esp32plc.pot.senal",
    "t1.esp32plc.jack.AI2",
    "t1.esp32plc.pot.vcc",
    "t1.esp32plc.pot.gnd",
    "t1.esp32plc.jack.5V",
    "t1.esp32plc.jack.GND"
  ],
  "verificacion": [
    {
      "txt": "El PLC (ESP32, Modbus TCP de la L7) responde en 192.168.1.10:502",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "mbpoll -m tcp -a 1 -t 4 -0 -r 0 -c 8 -1 192.168.1.10 2>&1",
          "regex": "\\[3\\]:",
          "max_ms": 9000
        }
      ]
    },
    {
      "txt": "Tu servidor OPC UA está levantado y escucha en 192.168.1.64:4841",
      "hacer": [
        {
          "tipo": "docker",
          "args": [
            "inspect",
            "-f",
            "{{.State.Running}}",
            "l14-opcua"
          ],
          "regex": "true"
        },
        {
          "tipo": "pc",
          "cmd": "nc -z -w 3 192.168.1.64 4841 && echo ABIERTO",
          "regex": "ABIERTO",
          "max_ms": 8000
        }
      ]
    },
    {
      "txt": "Tu servidor publica el modelo completo (Potenciometro y RelA con los NodeId de la L13)",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "curl -s --max-time 6 http://192.168.1.64:8096/api/estado 2>&1",
          "regex": "^(?=.*\"Potenciometro\")(?=.*\"RelA\")(?=.*\"Remote\")(?=.*\"i=1011\")(?=.*\"i=1014\")",
          "max_ms": 8000
        }
      ]
    },
    {
      "txt": "Parte A · tu datalogger escribió datos_planta.csv con cabecera Fecha, Hora y al menos 10 muestras",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "head -1 ~/trabajo/L14/datos_planta.csv; wc -l < ~/trabajo/L14/datos_planta.csv",
          "regex": "Fecha.*Hora[\\s\\S]*\\n(1[1-9]|[2-9][0-9]|[0-9]{3,})\\s*$",
          "max_ms": 6000
        }
      ]
    },
    {
      "txt": "Reto · termostato: con el potenciómetro por encima de 500 tu script cierra REL-A",
      "hacer": [
        {
          "tipo": "analogica",
          "equipo": "t1.esp32plc",
          "i": 2,
          "v": 3300
        },
        {
          "tipo": "esperar",
          "equipo": "t1.esp32plc",
          "rele": {
            "0": 1
          },
          "max_ms": 7000
        }
      ]
    },
    {
      "txt": "Reto · termostato: con el potenciómetro por debajo de 500 lo abre",
      "hacer": [
        {
          "tipo": "analogica",
          "equipo": "t1.esp32plc",
          "i": 2,
          "v": 400
        },
        {
          "tipo": "esperar",
          "equipo": "t1.esp32plc",
          "rele": {
            "0": 0
          },
          "max_ms": 7000
        }
      ]
    },
    {
      "txt": "Escritura · tu script activó Remote y escribió por OPC UA (el servidor registra las escrituras)",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "curl -s --max-time 6 http://192.168.1.64:8096/api/estado 2>&1",
          "regex": "\"escrituras\":\\s*[1-9]",
          "max_ms": 8000
        }
      ]
    }
  ],
  "guia": [
    [
      "pc.eth",
      "t1.switch.p1"
    ],
    [
      "t1.esp32plc.eth",
      "t1.switch.p2"
    ],
    [
      "t1.esp32plc.pot.vcc",
      "t1.esp32plc.jack.5V"
    ],
    [
      "t1.esp32plc.pot.gnd",
      "t1.esp32plc.jack.GND"
    ],
    [
      "t1.esp32plc.pot.senal",
      "t1.esp32plc.jack.AI2"
    ]
  ]
}
