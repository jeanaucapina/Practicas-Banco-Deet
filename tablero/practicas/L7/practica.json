{
  "id": "L7",
  "titulo": "Modbus TCP por Ethernet industrial",
  "equipo": "t1.esp32plc",
  "lenguajes": [
    "ino"
  ],
  "enunciado": "enunciado.md",
  "plantilla": "plantilla.ino",
  "montaje": {
    "limpiar": true,
    "cables": [
      [
        "t1.esp32plc.eth",
        "t1.switch.p1"
      ],
      [
        "pc.eth",
        "t1.switch.p2"
      ],
      [
        "t1.esp32plc.usb",
        "pc.usb1"
      ]
    ],
    "ordenes": [],
    "sin_openplc": true
  },
  "marcar": [
    "t1.esp32plc.eth",
    "pc.eth",
    "t1.esp32plc.usb"
  ],
  "verificacion": [
    {
      "txt": "Parte I · el PC alcanza 192.168.1.10 (ping sin pérdidas)",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "ping -c 3 -W 1 192.168.1.10",
          "regex": " 0% packet loss",
          "max_ms": 8000
        }
      ]
    },
    {
      "txt": "Parte I · ARP resuelve la MAC DE:AD:BE:EF:FE:0A",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "ping -c 1 -W 1 192.168.1.10 >/dev/null; ip neigh show 192.168.1.10",
          "regex": "(?i)de:ad:be:ef:fe:0a"
        }
      ]
    },
    {
      "txt": "Parte I · el puerto 502 escucha (nc -vz)",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "nc -vz -w 2 192.168.1.10 502 2>&1",
          "regex": "(?i)succeeded|open"
        }
      ]
    },
    {
      "txt": "Parte II · mbpoll lee los ocho registros holding (FC3)",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "mbpoll -m tcp -a 1 -t 4 -0 -r 0 -c 8 -1 192.168.1.10",
          "regex": "\\[7\\]:"
        }
      ]
    },
    {
      "txt": "Parte II · [0] sigue al potenciómetro de I0.7 (mitad de recorrido ≈ 511)",
      "hacer": [
        {
          "tipo": "analogica",
          "equipo": "t1.esp32plc",
          "i": 2,
          "v": 2048
        },
        {
          "tipo": "pausa",
          "ms": 800
        },
        {
          "tipo": "pc",
          "cmd": "mbpoll -m tcp -a 1 -t 4 -0 -r 0 -c 1 -1 192.168.1.10",
          "regex": "\\[0\\]:\\s+5(0\\d|1[0-9]|2[0-4])\\b",
          "max_ms": 4000
        }
      ]
    },
    {
      "txt": "Parte III · FC6 en [4] cierra REL-A",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "mbpoll -m tcp -a 1 -t 4 -0 -r 4 192.168.1.10 1",
          "regex": "(?i)written"
        },
        {
          "tipo": "esperar",
          "equipo": "t1.esp32plc",
          "rele": {
            "0": 1
          },
          "max_ms": 3000
        }
      ]
    },
    {
      "txt": "Parte III · FC16 pone los cuatro actuadores en 0 1 0 1 en una transacción",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "mbpoll -m tcp -a 1 -t 4 -0 -r 4 192.168.1.10 0 1 0 1",
          "regex": "(?i)written 4"
        },
        {
          "tipo": "esperar",
          "equipo": "t1.esp32plc",
          "rele": {
            "0": 0,
            "1": 1
          },
          "do": {
            "2": 0,
            "3": 1
          },
          "max_ms": 3000
        }
      ]
    },
    {
      "txt": "Parte III · los contadores [2] y [3] cuentan escrituras, no lecturas",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "mbpoll -m tcp -a 1 -t 4 -0 -r 2 -c 2 -1 192.168.1.10",
          "regex": "\\[2\\]:\\s+[1-9]"
        }
      ]
    }
  ]
}
