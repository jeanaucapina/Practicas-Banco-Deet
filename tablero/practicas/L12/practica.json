{
  "id": "L12",
  "titulo": "Comunicación entre tableros: RS-485 y Ethernet entre dos bancos",
  "equipo": "t1.controllino",
  "exige_programa": false,
  "lenguajes": [],
  "enunciado": "enunciado.md",
  "reiniciar": false,
  "montaje": {
    "limpiar": true,
    "cables": [
      ["t1.controllino.eth", "t1.switch.p1"],
      ["pc.eth", "t1.switch.p2"],
      ["t2.controllino.eth", "t2.switch.p1"]
    ],
    "energia": [["t1.controllino", true], ["t2.controllino", true], ["t1.switch", true], ["t2.switch", true]],
    "ordenes": [["t1.controllino", {"cmd": "modo", "v": 0}], ["t2.controllino", {"cmd": "modo", "v": 0}]]
  },
  "marcar": ["t1.controllino.485A", "t1.controllino.485B", "t2.controllino.485A", "t2.controllino.485B",
             "t1.switch.p4", "t2.switch.p4"],
  "verificacion": [
    {"txt": "Parte A · bus RS-485 entre tableros: el Controllino 1 (MAESTRO 485) enciende la fila de arriba del tablero 2",
     "hacer": [{"tipo": "orden", "equipo": "t1.controllino", "orden": {"cmd": "modo", "v": 3}, "ms": 500},
               {"tipo": "entrada", "equipo": "t1.controllino", "i": 16, "v": 1},
               {"tipo": "esperar", "equipo": "t2.controllino", "do": {"0": 1, "6": 1, "12": 1}, "max_ms": 4000},
               {"tipo": "entrada", "equipo": "t1.controllino", "i": 16, "v": 0}]},
    {"txt": "Parte A · la orden viajó por Modbus RTU (el maestro registra «RTU 2 OK»)",
     "hacer": [{"tipo": "estado", "equipo": "t1.controllino", "clave": "maestro.ultimo", "regex": "RTU 2 OK", "max_ms": 3000}]},
    {"txt": "Parte B · los switches están unidos: el PC (switch del tablero 1) alcanza al Controllino 2 (192.168.1.12)",
     "hacer": [{"tipo": "pc", "cmd": "ping -c 2 -W 1 192.168.1.12", "regex": " 0% packet loss", "max_ms": 8000}]},
    {"txt": "Parte B · Ethernet entre tableros: con MAESTRO TCP, I17 del tablero 1 enciende la fila del medio del tablero 2",
     "hacer": [{"tipo": "orden", "equipo": "t1.controllino", "orden": {"cmd": "modo", "v": 4}, "ms": 500},
               {"tipo": "entrada", "equipo": "t1.controllino", "i": 17, "v": 1},
               {"tipo": "esperar", "equipo": "t2.controllino", "do": {"1": 1, "7": 1, "13": 1}, "max_ms": 4000},
               {"tipo": "entrada", "equipo": "t1.controllino", "i": 17, "v": 0}]},
    {"txt": "Parte B · la orden viajó por Modbus TCP (el maestro registra «TCP 2 OK»)",
     "hacer": [{"tipo": "estado", "equipo": "t1.controllino", "clave": "maestro.ultimo", "regex": "TCP 2 OK", "max_ms": 3000},
               {"tipo": "orden", "equipo": "t1.controllino", "orden": {"cmd": "modo", "v": 0}}]},
    {"txt": "Parte C · hoja: sin latiguillo el tablero 2 no se alcanza (100 % de pérdida) y con latiguillo sí (0 %)",
     "hacer": [{"tipo": "pc", "cmd": "cat ~/trabajo/L12/respuestas.txt",
                "regex": "(?m)^perdida_sin_latiguillo\\s*=\\s*100\\s*$[\\s\\S]*^perdida_con_latiguillo\\s*=\\s*0\\s*$"}]}
  ]
}
