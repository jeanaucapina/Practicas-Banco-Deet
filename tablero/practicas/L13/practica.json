{
  "id": "L13",
  "titulo": "OPC UA · nivel de entrada: tu servidor del tablero y UaExpert",
  "equipo": "t1.esp32plc",
  "exige_programa": false,
  "lenguajes": [],
  "enunciado": "enunciado.md",
  "reiniciar": false,
  "montaje": {
    "limpiar": true,
    "cables": [],
    "energia": [
      [
        "t1.esp32plc",
        true
      ],
      [
        "t1.switch",
        true
      ]
    ],
    "cargar_plc": [
      [
        "t1.esp32plc",
        "_comun/plc_modbus_tcp.ino"
      ]
    ],
    "ordenes": [],
    "pila": true,
    "pc_actualizar": [
      "servidor_opcua.py",
      "docker-compose.yml"
    ]
  },
  "marcar": [
    "pc.eth",
    "t1.switch.p1",
    "t1.esp32plc.eth",
    "t1.switch.p2",
    "t1.esp32plc.pot.senal",
    "t1.esp32plc.jack.AI2",
    "t1.esp32plc.pot.vcc",
    "t1.esp32plc.pot.gnd",
    "t1.esp32plc.jack.5V",
    "t1.esp32plc.jack.GND"
  ],
  "verificacion": [
    {
      "txt": "El PLC (ESP32, Modbus TCP de la L7) responde en 192.168.1.10:502",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "mbpoll -m tcp -a 1 -t 4 -0 -r 0 -c 8 -1 192.168.1.10 2>&1",
          "regex": "\\[3\\]:",
          "max_ms": 9000
        }
      ]
    },
    {
      "txt": "Tu servidor OPC UA está levantado y escucha en 192.168.1.64:4841",
      "hacer": [
        {
          "tipo": "docker",
          "args": [
            "inspect",
            "-f",
            "{{.State.Running}}",
            "l13-opcua"
          ],
          "regex": "true"
        },
        {
          "tipo": "pc",
          "cmd": "nc -z -w 3 192.168.1.64 4841 && echo ABIERTO",
          "regex": "ABIERTO",
          "max_ms": 8000
        }
      ]
    },
    {
      "txt": "El servidor ve al PLC por Modbus (la pasarela Modbus ↔ OPC UA funciona)",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "curl -s --max-time 6 http://192.168.1.64:8096/api/estado 2>&1",
          "regex": "\"plc\":\\s*true",
          "max_ms": 8000
        }
      ]
    },
    {
      "txt": "OE1 · tu modelo.json define las ocho variables de la tabla 1 con sus NodeId (1010 a 1017)",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "curl -s --max-time 6 http://192.168.1.64:8096/api/estado 2>&1",
          "regex": "^(?=.*\"Remote\")(?=.*\"Potenciometro\")(?=.*\"RealimRelA\")(?=.*\"Escrituras\")(?=.*\"RelA\")(?=.*\"RelB\")(?=.*\"Q02\")(?=.*\"Q03\")(?=.*\"i=1010\")(?=.*\"i=1011\")(?=.*\"i=1012\")(?=.*\"i=1013\")(?=.*\"i=1014\")(?=.*\"i=1015\")(?=.*\"i=1016\")(?=.*\"i=1017\")",
          "max_ms": 8000
        }
      ]
    },
    {
      "txt": "Reto · creaste la variable SetPoint_Alarma (NodeId 1018, UInt16, escribible)",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "curl -s --max-time 6 http://192.168.1.64:8096/api/estado 2>&1",
          "regex": "\"nombre\":\\s*\"SetPoint_Alarma\",\\s*\"nodeid\":\\s*\"i=1018\",\\s*\"tipo\":\\s*\"UInt16\"",
          "max_ms": 8000
        }
      ]
    },
    {
      "txt": "Navegación · te conectaste con un cliente OPC UA (UaExpert) y exploraste el espacio de nombres",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "curl -s --max-time 6 http://192.168.1.64:8096/api/estado 2>&1",
          "regex": "\"sesiones_max\":\\s*[1-9]",
          "max_ms": 8000
        }
      ]
    },
    {
      "txt": "Suscripción · UaExpert creó monitored items: el servidor avisa de los cambios sin que preguntes",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "curl -s --max-time 6 http://192.168.1.64:8096/api/estado 2>&1",
          "regex": "\"suscripciones_max\":\\s*[1-9]",
          "max_ms": 8000
        }
      ]
    },
    {
      "txt": "Interbloqueo · intentaste escribir un relé con Remote = false y el servidor lo rechazó",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "curl -s --max-time 6 http://192.168.1.64:8096/api/estado 2>&1",
          "regex": "\"rechazadas\":\\s*[1-9]",
          "max_ms": 8000
        }
      ]
    },
    {
      "txt": "Escritura · con Remote = true, la escritura OPC UA llegó al PLC",
      "hacer": [
        {
          "tipo": "pc",
          "cmd": "curl -s --max-time 6 http://192.168.1.64:8096/api/estado 2>&1",
          "regex": "\"escrituras\":\\s*[1-9]",
          "max_ms": 8000
        }
      ]
    }
  ],
  "guia": [
    [
      "pc.eth",
      "t1.switch.p1"
    ],
    [
      "t1.esp32plc.eth",
      "t1.switch.p2"
    ],
    [
      "t1.esp32plc.pot.vcc",
      "t1.esp32plc.jack.5V"
    ],
    [
      "t1.esp32plc.pot.gnd",
      "t1.esp32plc.jack.GND"
    ],
    [
      "t1.esp32plc.pot.senal",
      "t1.esp32plc.jack.AI2"
    ]
  ]
}
